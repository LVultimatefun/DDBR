# =============================================================================
# robo_vlm_qc Environment Configuration Template
# Copy this file to `.env` and fill in your credentials. NEVER commit `.env`.
# =============================================================================

# --- VLM Provider API Keys ---------------------------------------------------
# Default preset (configs/default.yaml & configs/presets/openai.yaml)
OPENAI_API_KEY=sk-replace-with-your-openai-api-key

# Optional provider presets (see configs/presets/):
# DASHSCOPE_API_KEY=sk-replace-with-your-dashscope-api-key
# GEMINI_API_KEY=replace-with-your-gemini-api-key
# VLLM_API_KEY=EMPTY

# --- Dual-Role Studio Authentication -----------------------------------------
# Required by `robo-vlm-qc serve` unless `--no-auth` is explicitly passed.
ROBO_VLM_QC_REVIEWER_TOKEN=change-me-reviewer-token
ROBO_VLM_QC_LEAD_TOKEN=change-me-lead-token

# --- Server Security & Optional Overrides ------------------------------------
# Comma-separated allowed CORS origins (defaults to localhost / 127.0.0.1 dev ports)
# ROBO_VLM_QC_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional port override for docker-compose.yml
# ROBO_VLM_QC_PORT=8000

# Optional path overrides (usually auto-detected)
# ROBO_VLM_QC_CONFIG_DIR=./configs
# ROBO_VLM_QC_WEB_DIST=./web/dist
